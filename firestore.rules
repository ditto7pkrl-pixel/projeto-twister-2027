rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasParticipantProfile(uid) {
      return exists(/databases/$(database)/documents/participants/$(uid));
    }
    match /participants/{uid} {
      // Signed-in participants can see the team's names and initial balances.
      allow read: if signedIn() && hasParticipantProfile(request.auth.uid);
      // Create participant documents manually in the Firebase Console.
      // No participant can edit their own initial balance or another profile.
      allow create, update, delete: if false;
    }
    match /deposits/{depositId} {
      // The shared ranking and history need read access for all authenticated participants.
      allow read: if signedIn() && hasParticipantProfile(request.auth.uid);
      allow create: if signedIn()
        && hasParticipantProfile(request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.personName == get(/databases/$(database)/documents/participants/$(request.auth.uid)).data.name
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.depositDate is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.personName == resource.data.personName
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.depositDate is string
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}